# Macro Brief — copy this file to `.env` in the repo root and fill in values.
# `.env` is gitignored; never commit real keys.

# --- Oxford Economics / Knoema EAP (required for KPI fetch) ---
EAP_HOST=
EAP_APP_ID=
EAP_APP_SECRET=

# --- OpenAI (required for dashboard insights + country brief LLM steps) ---
OPENAI_API_KEY=
# Optional: leave empty for default OpenAI API; set for Azure / compatible gateways
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Newscatcher (required for news context on dashboard KPI insights) ---
NEWSCATCHER_API_KEY=

# --- Perplexity (optional — Country Brief deep analysis / correlated news) ---
PERPLEXITY_API_KEY=
# Optional; default is https://api.perplexity.ai if unset
PERPLEXITY_URL=
PERPLEXITY_MODEL=sonar

# --- SQLite workspaces (default path; ensure directory exists — see README) ---
DATABASE_URL=sqlite+aiosqlite:///./data/macrobrief.db

# Forecast labeling in prompts (calendar year of last “actual” data)
LAST_ACTUAL_YEAR=2025

# --- Optional ---
# Extra debug endpoints / UI (see launch.py --debug and backend routers)
# MACROBRIEF_DEBUG=1

# Use GPT to pick FDI benchmark peers (default is deterministic, no extra LLM call)
# BENCHMARK_USE_LLM=1
